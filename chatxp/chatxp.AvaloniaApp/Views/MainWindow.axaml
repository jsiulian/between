<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:chatxp.AvaloniaApp.ViewModels"
        xmlns:services="using:chatxp.AvaloniaApp.Services"
        xmlns:cnv="using:chatxp.AvaloniaApp.Converters"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="860" d:DesignHeight="620"
        x:Class="chatxp.AvaloniaApp.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="chatxp — Between, cross-platform"
        Icon="avares://chatxp.AvaloniaApp/Assets/chatxp.ico"
        Width="860" Height="620">

    <Design.DataContext>
        <vm:MainViewModel />
    </Design.DataContext>

    <Window.Resources>
        <cnv:MineToBackgroundConverter x:Key="MineToBackground" />
        <cnv:MineToForegroundConverter x:Key="MineToForeground" />
        <cnv:MineToAlignmentConverter x:Key="MineToAlignment" />
        <cnv:BoolToBrushConverter x:Key="BoolToBrush" />
        <cnv:CountIsConverter x:Key="CountIs" />
    </Window.Resources>

    <Grid RowDefinitions="Auto,*,Auto">
        <!-- Header (themed chrome) -->
        <Border Grid.Row="0" Background="{DynamicResource ChromeBrush}" Padding="14,10">
            <Grid ColumnDefinitions="*,Auto,Auto">
                <StackPanel Grid.Column="0" Spacing="2">
                    <TextBlock Text="My ID" FontSize="11" Opacity="0.6"
                               Foreground="{DynamicResource MutedForeground}"/>
                    <Button Command="{Binding CopyMyIdCommand}" Padding="0" Background="Transparent"
                            BorderThickness="0" HorizontalAlignment="Left" Cursor="Hand">
                        <TextBlock Text="{Binding MyId}" FontFamily="Monospace" FontSize="11"
                                   Foreground="{DynamicResource IdLinkBrush}"
                                   TextTrimming="CharacterEllipsis" MaxWidth="440"/>
                    </Button>
                </StackPanel>
                <!-- Notifications badge -->
                <Button Grid.Column="1" Command="{Binding ShowNotificationsCommand}"
                        Margin="0,0,8,0" Padding="0">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{DynamicResource PillBrush}" CornerRadius="12"
                                    Padding="10,4" IsVisible="{TemplateBinding IsEnabled}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <TextBlock Text="🔔" FontSize="13"/>
                                    <TextBlock Text="{Binding Requests.Count}"
                                               Foreground="{DynamicResource ChromeForeground}" FontSize="12"/>
                                </StackPanel>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
                <Border Grid.Column="2" CornerRadius="12" Background="{DynamicResource PillBrush}"
                        Padding="10,4" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Status}" Foreground="{DynamicResource ChromeForeground}"
                               FontSize="12"/>
                </Border>
            </Grid>
        </Border>

        <!-- ===== Main surface: tabs (no Chat tab). The chat is an overlay. ===== -->
        <TabControl Grid.Row="1" x:Name="MainTabs">

            <!-- ===== Contacts ===== -->
            <TabItem Header="Contacts">
                <Grid RowDefinitions="Auto,*">
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="10" Margin="16,12,16,0">
                        <TextBlock Text="Contacts" FontSize="16" FontWeight="Bold" VerticalAlignment="Center"/>
                        <Button Content="＋ Add contact" Command="{Binding OpenAddContactCommand}"
                                Padding="10,4"/>
                    </StackPanel>
                    <ScrollViewer Grid.Row="1">
                        <StackPanel Spacing="8" Margin="16,10,16,16">
                            <!-- Add-contact form (mandatory nickname; optional per-contact server) -->
                            <Border IsVisible="{Binding IsNewContactFormOpen}"
                                    Background="{DynamicResource FormBrush}" CornerRadius="10" Padding="14">
                                <StackPanel Spacing="8">
                                    <TextBlock Text="New contact" FontWeight="Bold"/>
                                    <TextBox Text="{Binding FormPeerId}" PlaceholderText="Peer ID (their public key)…"/>
                                    <TextBox Text="{Binding FormNickname}" PlaceholderText="Nickname (required)…"/>
                                    <TextBox Text="{Binding FormServer}" PlaceholderText="Signaling server for this contact (ws://…; blank = current server)…"/>
                                    <TextBlock Text="{Binding FormError}" Foreground="{DynamicResource DangerBrush}"
                                               FontSize="11"
                                               IsVisible="{Binding FormError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Button Content="Save" Command="{Binding SaveNewContactCommand}" Padding="14,4"/>
                                        <Button Content="Cancel" Command="{Binding CancelContactFormCommand}" Padding="14,4"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                            <!-- Edit-contact form -->
                            <Border IsVisible="{Binding IsEditContactFormOpen}"
                                    Background="{DynamicResource FormBrush}" CornerRadius="10" Padding="14">
                                <StackPanel Spacing="8">
                                    <TextBlock Text="Edit contact" FontWeight="Bold"/>
                                    <TextBox Text="{Binding FormNickname}" PlaceholderText="Nickname…"/>
                                    <TextBox Text="{Binding FormServer}" PlaceholderText="Signaling server (ws://…; blank = current server)…"/>
                                    <TextBlock Text="{Binding FormError}" Foreground="{DynamicResource DangerBrush}"
                                               FontSize="11"
                                               IsVisible="{Binding FormError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Button Content="Save" Command="{Binding SaveEditContactCommand}" Padding="14,4"/>
                                        <Button Content="Cancel" Command="{Binding CancelContactFormCommand}" Padding="14,4"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <TextBlock Text="(no contacts yet)" Opacity="0.5" FontStyle="Italic"
                                       IsVisible="{Binding Contacts.Count, Converter={StaticResource CountIs}, ConverterParameter=empty}"/>
                            <ItemsControl ItemsSource="{Binding Contacts}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="services:ContactView">
                                        <!-- Row visual: base + hover from the app-level
                                             contactRow styles (theme-aware hover brush). -->
                                        <Border Classes="contactRow"
                                                CornerRadius="10" Padding="12,8" Margin="0,0,0,6">
                                            <Grid ColumnDefinitions="*,Auto,Auto,Auto">
                                                <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Nickname}" FontWeight="SemiBold" FontSize="14"/>
                                                    <TextBlock Text="{Binding IdPreview}" FontFamily="Monospace"
                                                               FontSize="10" Opacity="0.55"/>
                                                    <TextBlock Text="{Binding Server}" FontFamily="Monospace"
                                                               FontSize="9" Opacity="0.4"
                                                               IsVisible="{Binding Server, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                                </StackPanel>
                                                <Button Grid.Column="1" Content="Chat" Margin="6,0"
                                                        Command="{Binding $parent[Window].DataContext.ConnectToContactCommand}"
                                                        CommandParameter="{Binding WebRtcId}" Padding="12,4"/>
                                                <Button Grid.Column="2" Content="✎" Margin="2,0"
                                                        Command="{Binding $parent[Window].DataContext.OpenEditContactCommand}"
                                                        CommandParameter="{Binding WebRtcId}" Padding="8,4"/>
                                                <Button Grid.Column="3" Content="🗑"
                                                        Command="{Binding $parent[Window].DataContext.DeleteContactCommand}"
                                                        CommandParameter="{Binding WebRtcId}" Padding="8,4"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </TabItem>

            <!-- ===== Notifications ===== -->
            <TabItem Header="Notifications">
                <ScrollViewer>
                    <StackPanel Spacing="10" Margin="16">
                        <TextBlock Text="Contact requests" FontSize="16" FontWeight="Bold"/>
                        <TextBlock TextWrapping="Wrap" Opacity="0.65"
                                   Text="Incoming connections from peers not yet in your contacts. Each request must be explicitly Accepted or Ignored — it stays until you decide."/>
                        <TextBlock Text="(no pending requests)" Opacity="0.5" FontStyle="Italic"
                                   IsVisible="{Binding Requests.Count, Converter={StaticResource CountIs}, ConverterParameter=empty}"/>
                        <ItemsControl ItemsSource="{Binding Requests}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="services:PendingRequestView">
                                    <Border Background="{DynamicResource CardBrush}" CornerRadius="10"
                                            Padding="14,10" Margin="0,0,0,8">
                                        <StackPanel Spacing="8">
                                            <TextBlock FontFamily="Monospace" FontSize="11" Text="{Binding PeerId}"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="wants to chat" Opacity="0.6" FontSize="12"/>
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <Button Content="Accept"
                                                        Command="{Binding $parent[Window].DataContext.AcceptRequestCommand}"
                                                        CommandParameter="{Binding PeerId}" Padding="16,5"/>
                                                <Button Content="Ignore"
                                                        Command="{Binding $parent[Window].DataContext.IgnoreRequestCommand}"
                                                        CommandParameter="{Binding PeerId}" Padding="16,5"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Separator/>
                        <TextBlock Text="(future notification types will appear here)" Opacity="0.4"
                                   FontStyle="Italic" FontSize="11"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ===== Settings ===== -->
            <TabItem Header="Settings">
                <ScrollViewer>
                    <StackPanel Spacing="10" Margin="20">
                        <TextBlock Text="My registration server" FontSize="16" FontWeight="Bold"/>
                        <TextBlock TextWrapping="Wrap" Opacity="0.7"
                                   Text="This is the signaling server you are registered (reachable) on — new contacts send their connection requests here. Changing it re-registers you immediately and becomes the default for future starts."/>
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBox Grid.Column="0" Text="{Binding SignalServer}" PlaceholderText="ws://host:port/"/>
                            <Button Grid.Column="1" Content="Register" Margin="8,0,0,0" Padding="14,4"
                                    Command="{Binding ApplyServerCommand}"
                                    IsEnabled="{Binding !ApplyingServer}"/>
                        </Grid>
                        <Separator/>
                        <Button Content="Copy my ID" Command="{Binding CopyMyIdCommand}"
                                HorizontalAlignment="Left" Padding="10,4"/>
                        <TextBlock TextWrapping="Wrap" Opacity="0.5" FontSize="11"
                                   Text="Per-contact servers: Contacts → add/edit (used when connecting to that contact)."/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ===== Diagnostics ===== -->
            <TabItem Header="Diagnostics">
                <Grid RowDefinitions="Auto,*" Margin="8">
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8" Margin="4,2">
                        <TextBlock Text="Connection log" FontSize="14" FontWeight="Bold"
                                   VerticalAlignment="Center"/>
                        <Button Content="Clear" Command="{Binding ClearLogCommand}" Padding="10,3"/>
                    </StackPanel>
                    <ListBox Grid.Row="1" ItemsSource="{Binding LogLines}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" TextWrapping="Wrap"
                                           FontFamily="Monospace" FontSize="11"/>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </TabItem>
        </TabControl>

        <!-- ===== Chat overlay: replaces the tab surface when a chat is open. ===== -->
        <Panel Grid.Row="1" IsVisible="{Binding HasActiveChat}" Background="{DynamicResource ChromeBrush}">
            <Grid RowDefinitions="Auto,*,Auto,Auto">
                <!-- Who you're talking to + Leave -->
                <Border Grid.Row="0" Background="{DynamicResource CardBrush}" Padding="12,8">
                    <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                        <Button Grid.Column="0" Content="← Contacts" Command="{Binding LeaveChatCommand}"
                                Padding="10,4" Margin="0,0,10,0"/>
                        <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
                            <TextBlock Text="{Binding ChatWith}" FontSize="15" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding ChatWithIdPreview}" FontFamily="Monospace" FontSize="10"
                                       Opacity="0.5"/>
                        </StackPanel>
                        <Button Grid.Column="2" Content="⟳ Reconnect" Command="{Binding ReconnectCommand}"
                                Padding="10,4" Margin="8,0,8,0"/>
                        <TextBlock Grid.Column="3" Text="{Binding ChatConnectionState}" FontSize="11" Opacity="0.6"
                                   VerticalAlignment="Center"/>
                    </Grid>
                </Border>
                <ListBox Grid.Row="1" x:Name="MessagesList" ItemsSource="{Binding Lines}"
                         Background="Transparent"
                         SelectionMode="Multiple"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Visible">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="services:ChatLine">
                            <Border CornerRadius="10" Padding="10,6" Margin="4" MaxWidth="440"
                                    Background="{Binding Mine, Converter={StaticResource MineToBackground}}"
                                    HorizontalAlignment="{Binding Mine, Converter={StaticResource MineToAlignment}}">
                                <Border.ContextMenu>
                                    <!-- Per-bubble menu: the DataContext here is the ChatLine
                                         itself, so CommandParameter binds naturally. -->
                                    <ContextMenu>
                                        <MenuItem Header="Copy message"
                                                  Command="{Binding $parent[Window].DataContext.CopyMessageCommand}"
                                                  CommandParameter="{Binding}"/>
                                    </ContextMenu>
                                </Border.ContextMenu>
                                <StackPanel Spacing="2">
                                    <TextBlock Text="{Binding Text}" TextWrapping="Wrap"
                                               Foreground="{Binding Mine, Converter={StaticResource MineToForeground}}"/>
                                    <TextBlock Text="{Binding Time}" FontSize="9" Opacity="0.55"
                                               Foreground="{Binding Mine, Converter={StaticResource MineToForeground}}"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <TextBlock Grid.Row="2" Text="peer is typing…" FontStyle="Italic" Opacity="0.6"
                           IsVisible="{Binding PeerIsTyping}" Margin="14,2"/>
                <Grid Grid.Row="3" ColumnDefinitions="*,Auto" Margin="10">
                    <TextBox Grid.Column="0" Text="{Binding InputText}" PlaceholderText="Message…"
                             KeyDown="OnInputKeyDown"
                             IsEnabled="{Binding IsConnected}"/>
                    <Button Grid.Column="1" Content="Send" Command="{Binding SendCommand}"
                            Margin="8,0,0,0" Padding="14,4" IsEnabled="{Binding IsConnected}"/>
                </Grid>
            </Grid>
        </Panel>

        <!-- Footer (themed chrome) -->
        <Border Grid.Row="2" Padding="14,8" Background="{DynamicResource ChromeBrush}">
            <StackPanel Orientation="Horizontal" Spacing="12">
                <Ellipse Width="10" Height="10" VerticalAlignment="Center">
                    <Ellipse.Fill>
                        <MultiBinding Converter="{StaticResource BoolToBrush}">
                            <Binding Path="IsConnected" />
                        </MultiBinding>
                    </Ellipse.Fill>
                </Ellipse>
                <TextBlock Text="{Binding ConnectionLabel}" FontSize="11"
                           Foreground="{DynamicResource ChromeForeground}"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
